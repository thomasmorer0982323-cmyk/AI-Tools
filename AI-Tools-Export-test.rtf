\pard\sb120\sa120\b\fs26 1.1.1 {\field{\*\fldinst{HYPERLINK "https://app.heygen.com"}}{\fldrslt{\cf1\ul HeyGen\ulnone\cf0}}}\b0\fs24\par
\pard\ql Website: {\field{\*\fldinst{HYPERLINK "https://app.heygen.com"}}{\fldrslt{\cf1\ul https://app.heygen.com\ulnone\cf0}}}\par
